<?xml version="1.0" encoding="UTF-8"?>
<!--
  Add-in only manifest (XML) for an Outlook Smart Alerts add-in.

  Before sideloading, replace every occurrence of
      https://YOUR-USERNAME.github.io/tim-cc-addin
  with the HTTPS base URL where the contents of the "docs" folder are hosted
  (see README.md). There are 9 occurrences.
-->
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
  xsi:type="MailApp">

  <Id>9b85704c-2839-4bda-b159-65b9597cda99</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Blob</ProviderName>
  <DefaultLocale>nl-NL</DefaultLocale>
  <DisplayName DefaultValue="Tim Cc check"/>
  <Description DefaultValue="Controleert bij verzenden of tim@blob.be in Aan, Cc of Bcc staat en biedt aan om hem in Cc te zetten."/>
  <IconUrl DefaultValue="https://YOUR-USERNAME.github.io/tim-cc-addin/assets/icon-64.png"/>
  <HighResolutionIconUrl DefaultValue="https://YOUR-USERNAME.github.io/tim-cc-addin/assets/icon-128.png"/>
  <SupportUrl DefaultValue="https://YOUR-USERNAME.github.io/tim-cc-addin/commands.html"/>

  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>

  <!-- Mailbox 1.14: send mode override (sendModeOverride) at runtime. -->
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.14"/>
    </Sets>
  </Requirements>

  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://YOUR-USERNAME.github.io/tim-cc-addin/commands.html"/>
        <RequestedHeight>250</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>

  <!-- ReadWriteMailbox is needed for item.sendAsync (Mailbox 1.15). Reading and editing
       recipients alone would only need ReadWriteItem. -->
  <Permissions>ReadWriteMailbox</Permissions>

  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
  </Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">

      <Requirements>
        <bt:Sets DefaultMinVersion="1.14">
          <bt:Set Name="Mailbox"/>
        </bt:Sets>
      </Requirements>

      <Hosts>
        <Host xsi:type="MailHost">

          <!-- Runtime used by event-based activation:
               - Outlook on the web / new Outlook load the HTML page (WebViewRuntime.Url),
               - classic Outlook on Windows loads the JavaScript file (Override). -->
          <Runtimes>
            <Runtime resid="WebViewRuntime.Url">
              <Override type="javascript" resid="JSRuntime.Url"/>
            </Runtime>
          </Runtimes>

          <DesktopFormFactor>
            <FunctionFile resid="WebViewRuntime.Url"/>

            <!-- Function command. Its Control id is the commandId used in the Smart Alerts dialog
                 ("Take Action" button). It also appears as a button on the compose ribbon. -->
            <ExtensionPoint xsi:type="MessageComposeCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="timCcGroup">
                  <Label resid="GroupLabel"/>
                  <Control xsi:type="Button" id="addTimToCcButton">
                    <Label resid="AddTimLabel"/>
                    <Supertip>
                      <Title resid="AddTimLabel"/>
                      <Description resid="AddTimDescription"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon.16x16"/>
                      <bt:Image size="32" resid="Icon.32x32"/>
                      <bt:Image size="80" resid="Icon.80x80"/>
                    </Icon>
                    <Action xsi:type="ExecuteFunction">
                      <FunctionName>addTimToCcCommand</FunctionName>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>

            <!-- Smart Alerts: runs onMessageSendHandler when the user selects Send.
                 SendMode="SoftBlock" is the manifest default; the handler switches to
                 "promptUser" at runtime with sendModeOverride (Mailbox 1.14). -->
            <ExtensionPoint xsi:type="LaunchEvent">
              <LaunchEvents>
                <LaunchEvent Type="OnMessageSend" FunctionName="onMessageSendHandler" SendMode="SoftBlock"/>
              </LaunchEvents>
              <SourceLocation resid="WebViewRuntime.Url"/>
            </ExtensionPoint>
          </DesktopFormFactor>

        </Host>
      </Hosts>

      <Resources>
        <bt:Images>
          <bt:Image id="Icon.16x16" DefaultValue="https://YOUR-USERNAME.github.io/tim-cc-addin/assets/icon-16.png"/>
          <bt:Image id="Icon.32x32" DefaultValue="https://YOUR-USERNAME.github.io/tim-cc-addin/assets/icon-32.png"/>
          <bt:Image id="Icon.80x80" DefaultValue="https://YOUR-USERNAME.github.io/tim-cc-addin/assets/icon-80.png"/>
        </bt:Images>
        <bt:Urls>
          <bt:Url id="WebViewRuntime.Url" DefaultValue="https://YOUR-USERNAME.github.io/tim-cc-addin/commands.html"/>
          <bt:Url id="JSRuntime.Url" DefaultValue="https://YOUR-USERNAME.github.io/tim-cc-addin/launchevent.js"/>
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="GroupLabel" DefaultValue="Tim Cc check"/>
          <bt:String id="AddTimLabel" DefaultValue="Tim toevoegen in cc"/>
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="AddTimDescription" DefaultValue="Voegt tim@blob.be toe aan Cc."/>
        </bt:LongStrings>
      </Resources>

    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
